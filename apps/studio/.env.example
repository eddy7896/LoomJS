# The env bucket for local development (docs/specs/connector-credentials.md).
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and never enters the project
# document: the snapshot stores the project URL and a credential *name*, never a value.
#
# The studio's dev server loads this file at startup and injects it into the Preview by name,
# which is exactly what Vercel does at deploy time (M6). Nothing else changes between the two.

# Your project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Anon key. Client-scoped: safe in a browser, protected by row-level security. The studio uses
# it to read your schema.
SUPABASE_ANON_KEY=

# Service role key. Server-scoped: it bypasses row-level security, so it is only ever read by
# the emitted serverless functions. The compiler refuses to let it reach client code, and the
# studio never sends it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
